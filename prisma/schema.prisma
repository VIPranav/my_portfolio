generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  DEV
  UIUX
  GRAPHIC
  VIDEO
  THREED
}

enum SkillLevel {
  FOUNDATIONAL
  PRACTICAL
  PROFICIENT
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Project {
  id        String         @id @default(cuid())
  slug      String         @unique
  title     String
  summary   String
  type      ProjectType
  year      Int
  role      String
  coverUrl  String
  modelUrl  String?
  liveUrl   String?
  repoUrl   String?
  overview  String         @db.Text
  problem   String?        @db.Text
  process   String?        @db.Text
  result    String?        @db.Text
  tools     String[]
  featured  Boolean        @default(false)
  published Boolean        @default(false)
  order     Int            @default(0)
  media     ProjectMedia[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([published, type, order])
}

model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  kind      String
  caption   String?
  order     Int     @default(0)
}

model SkillCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  order  Int     @default(0)
  skills Skill[]
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  level      SkillLevel
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order      Int           @default(0)
}

model Milestone {
  id          String @id @default(cuid())
  year        String
  title       String
  description String @db.Text
  order       Int    @default(0)
}

model Message {
  id          String        @id @default(cuid())
  name        String
  email       String
  projectType String
  budget      String?
  body        String        @db.Text
  status      MessageStatus @default(NEW)
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}

model Setting {
  key   String @id
  value String @db.Text
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Asset {
  id        String   @id @default(cuid())
  bytes     Bytes
  mimeType  String
  createdAt DateTime @default(now())
}
